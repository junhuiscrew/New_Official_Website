# 项目运行环境
APP_ENV=development
APP_NAME=Junhui Global Website API
APP_VERSION=0.4.0
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8010

# PostgreSQL（示例值仅用于本地开发，请在真实环境中替换）
POSTGRES_DB=junhui
POSTGRES_USER=junhui
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://junhui:change-me-local-only@postgres:5432/junhui

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=junhui-local-admin
MINIO_ROOT_PASSWORD=change-me-minio-local-only
MINIO_ENDPOINT=minio:9000
# 浏览器预签名 URL 使用的外部端点；不得填写 Docker 内部主机名 minio
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=junhui-local-admin
MINIO_SECRET_KEY=change-me-minio-local-only
MINIO_SECURE=false
MINIO_PUBLIC_BUCKET=public-media
MINIO_PRIVATE_BUCKET=private-rfq
MINIO_REGION=us-east-1

# Authentication（示例值只允许 development/test）
JWT_SIGNING_SECRET=change-me-jwt-local-only
REFRESH_TOKEN_SECRET=change-me-refresh-local-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Cookie CORS allowlist；生产环境只保留正式 Origin
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080"]

# 仅在 API 确实位于受控反向代理之后时填写；直连开发环境保持空数组
TRUSTED_PROXY_CIDRS=[]

# Public URLs
NUXT_PUBLIC_SITE_URL=https://junhuiscrewbarrel.com
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_API_INTERNAL_BASE=http://api:8000/api/v1
NUXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Public discovery delivery（FAQPage 默认关闭，不承诺 FAQ Rich Result）
PUBLIC_SITEMAP_ENABLED=true
LLMS_TXT_ENABLED=true
PUBLIC_MEDIA_MAX_FILE_BYTES=26214400
RFQ_MAX_FILE_BYTES=26214400
RFQ_MAX_TOTAL_FILE_BYTES=104857600
RFQ_MAX_FILES=10
RFQ_RATE_LIMIT_PER_HOUR=5
RFQ_RATE_LIMIT_PER_DAY=20
RFQ_RETENTION_DAYS=730
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_HOST=clamav
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_SECONDS=30
RFQ_SUBMISSION_TOKEN_TTL_MINUTES=30
FAQ_SCHEMA_ENABLED=false
