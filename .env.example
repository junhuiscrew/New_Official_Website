# 项目运行环境
APP_ENV=development
APP_NAME=Junhui Global Website API
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8010

# PostgreSQL（示例值仅用于本地开发，请在真实环境中替换）
POSTGRES_DB=junhui
POSTGRES_USER=junhui
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://junhui:change-me-local-only@postgres:5432/junhui

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=junhui-local-admin
MINIO_ROOT_PASSWORD=change-me-minio-local-only
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=junhui-local-admin
MINIO_SECRET_KEY=change-me-minio-local-only
MINIO_SECURE=false
MINIO_PUBLIC_BUCKET=public-media
MINIO_PRIVATE_BUCKET=private-rfq

# Public URLs
NUXT_PUBLIC_SITE_URL=https://junhuiscrewbarrel.com
NUXT_PUBLIC_API_BASE=http://localhost:8010/api/v1
NUXT_PUBLIC_ADMIN_URL=http://localhost:3001
